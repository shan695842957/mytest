### 场景 4：处理数据库迁移

**参考文件**: `database/migration_001_audit_logs.sql`

```sql
-- database/migration_002_add_devices.sql

-- ⭐ 统一的迁移脚本格式

-- 1. 添加注释说明
-- 迁移版本: v1.2.0
-- 创建时间: 2024-01-15
-- 说明: 添加设备管理表

-- 2. 创建表
CREATE TABLE IF NOT EXISTS devices (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name VARCHAR(100) NOT NULL UNIQUE,
    type VARCHAR(50) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'offline',
    created_by INTEGER,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (created_by) REFERENCES users(id)
);

-- 3. 创建索引
CREATE INDEX idx_devices_type ON devices(type);
CREATE INDEX idx_devices_status ON devices(status);
CREATE INDEX idx_devices_created_by ON devices(created_by);

-- 4. 创建触发器
CREATE TRIGGER IF NOT EXISTS update_devices_timestamp 
AFTER UPDATE ON devices
FOR EACH ROW
BEGIN
    UPDATE devices SET updated_at = CURRENT_TIMESTAMP WHERE id = OLD.id;
END;

-- 5. 插入初始数据（如果需要）
INSERT INTO devices (name, type, status, created_by) 
VALUES ('默认设备', 'default', 'online', 1);
