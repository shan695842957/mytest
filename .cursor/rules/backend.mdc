### 场景 1：添加新的 API 模块（如添加设备管理）

**参考文件**: `app/api/auth.py`, `app/models/user.py`, `app/crud/user.py`, `app/schemas/user.py`

#### 步骤：

1. **创建数据库表**（`database/migration_xxx.sql`）
```sql
-- 参考 init_schema.sql
CREATE TABLE IF NOT EXISTS devices (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name VARCHAR(100) NOT NULL UNIQUE,
    type VARCHAR(50) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'offline',
    created_by INTEGER,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (created_by) REFERENCES users(id)
);

CREATE INDEX idx_devices_type ON devices(type);
CREATE INDEX idx_devices_status ON devices(status);

-- 自动更新 updated_at 触发器
CREATE TRIGGER IF NOT EXISTS update_devices_timestamp 
AFTER UPDATE ON devices
FOR EACH ROW
BEGIN
    UPDATE devices SET updated_at = CURRENT_TIMESTAMP WHERE id = OLD.id;
END;
```

2. **创建 SQLAlchemy 模型**（`app/models/device.py`）
```python
# ⭐ 参考 app/models/user.py
from sqlalchemy import Column, Integer, String, DateTime, ForeignKey
from sqlalchemy.sql import func
from app.database import Base

class Device(Base):
    """设备模型"""
    __tablename__ = "devices"
    
    id = Column(Integer, primary_key=True, index=True)
    name = Column(String(100), unique=True, nullable=False, index=True)
    type = Column(String(50), nullable=False, index=True)
    status = Column(String(20), nullable=False, default="offline")
    created_by = Column(Integer, ForeignKey("users.id"))
    created_at = Column(DateTime(timezone=True), server_default=func.now())
    updated_at = Column(DateTime(timezone=True), server_default=func.now(), onupdate=func.now())
```

3. **创建 Pydantic Schema**（`app/schemas/device.py`）
```python
# ⭐ 参考 app/schemas/user.py
from pydantic import BaseModel, Field
from datetime import datetime
from typing import Optional

class DeviceBase(BaseModel):
    """设备基础 Schema"""
    name: str = Field(..., min_length=1, max_length=100, description="设备名称")
    type: str = Field(..., description="设备类型")
    status: str = Field(default="offline", description="设备状态")

class DeviceCreate(DeviceBase):
    """创建设备 Schema"""
    pass

class DeviceUpdate(BaseModel):
    """更新设备 Schema"""
    name: Optional[str] = Field(None, min_length=1, max_length=100)
    type: Optional[str] = None
    status: Optional[str] = None

class DeviceResponse(DeviceBase):
    """设备响应 Schema"""
    id: int
    created_by: Optional[int]
    created_at: datetime
    updated_at: datetime
    
    model_config = {"from_attributes": True}
```

4. **创建 CRUD 操作**（`app/crud/device.py`）
```python
# ⭐ 参考 app/crud/user.py
from typing import Optional, List
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, func
from app.models.device import Device
from app.schemas.device import DeviceCreate, DeviceUpdate

class DeviceCRUD:
    """设备 CRUD 操作"""
    
    async def get_by_id(self, db: AsyncSession, device_id: int) -> Optional[Device]:
        """根据 ID 获取设备"""
        result = await db.execute(select(Device).where(Device.id == device_id))
        return result.scalar_one_or_none()
    
    async def get_by_name(self, db: AsyncSession, name: str) -> Optional[Device]:
        """根据名称获取设备"""
        result = await db.execute(select(Device).where(Device.name == name))
        return result.scalar_one_or_none()
    
    async def get_multi(
        self,
        db: AsyncSession,
        skip: int = 0,
        limit: int = 100,
        device_type: Optional[str] = None
    ) -> tuple[List[Device], int]:
        """获取设备列表"""
        query = select(Device)
        count_query = select(func.count(Device.id))
        
        if device_type:
            query = query.where(Device.type == device_type)
            count_query = count_query.where(Device.type == device_type)
        
        # 获取总数
        total_result = await db.execute(count_query)
        total = total_result.scalar()
        
        # 获取列表
        query = query.offset(skip).limit(limit).order_by(Device.created_at.desc())
        result = await db.execute(query)
        devices = result.scalars().all()
        
        return list(devices), total
    
    async def create(
        self,
        db: AsyncSession,
        device_in: DeviceCreate,
        creator_id: int
    ) -> Device:
        """创建设备"""
        device = Device(
            **device_in.model_dump(),
            created_by=creator_id
        )
        db.add(device)
        await db.commit()
        await db.refresh(device)
        return device
    
    async def update(
        self,
        db: AsyncSession,
        device: Device,
        device_in: DeviceUpdate
    ) -> Device:
        """更新设备"""
        update_data = device_in.model_dump(exclude_unset=True)
        for field, value in update_data.items():
            setattr(device, field, value)
        await db.commit()
        await db.refresh(device)
        return device
    
    async def delete(self, db: AsyncSession, device: Device) -> None:
        """删除设备"""
        await db.delete(device)
        await db.commit()

# 全局实例
device_crud = DeviceCRUD()
```

5. **创建 API 路由**（`app/api/device.py`）
```python
# ⭐ 参考 app/api/auth.py
from typing import List, Optional
from fastapi import APIRouter, Depends, HTTPException, status, Query, Request
from sqlalchemy.ext.asyncio import AsyncSession

from app.database import get_db
from app.schemas.device import DeviceCreate, DeviceUpdate, DeviceResponse
from app.schemas.response import ApiResponse, success_response, paginated_response
from app.models.device import Device
from app.models.user import User
from app.crud.device import device_crud
from app.core.dependencies import set_audit_target, set_audit_changes
from app.middleware.audit import audit_route
from app.api.deps import get_current_user, get_locale, get_request_id
from app.i18n import t

router = APIRouter(tags=["设备管理"])

# ⭐ 创建设备
@router.post(
    "",
    response_model=ApiResponse[DeviceResponse],
    summary="创建设备",
    description="创建新设备"
)
@audit_route(
    module="device",
    action="create_device",
    action_key="audit.action.device_created"
)
async def create_device(
    device_in: DeviceCreate,
    request: Request,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
    locale: str = Depends(get_locale),
    request_id: str = Depends(get_request_id)
) -> ApiResponse[DeviceResponse]:
    """创建设备"""
    
    # 检查名称是否已存在
    existing = await device_crud.get_by_name(db, device_in.name)
    if existing:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=t("device.error.name_exists", locale)
        )
    
    # 创建设备
    device = await device_crud.create(db, device_in, current_user.id)
    
    # ⭐ 设置审计目标（中间件会自动记录）
    set_audit_target(request, "device", str(device.id), device.name)
    
    return success_response(
        data=DeviceResponse.model_validate(device),
        message=t("device.success.created", locale),
        locale=locale,
        request_id=request_id
    )

# ⭐ 获取设备列表
@router.get(
    "",
    response_model=ApiResponse[List[DeviceResponse]],
    summary="获取设备列表",
    description="分页获取设备列表"
)
async def list_devices(
    skip: int = Query(0, ge=0, description="跳过记录数"),
    limit: int = Query(20, ge=1, le=100, description="每页记录数"),
    device_type: Optional[str] = Query(None, description="设备类型筛选"),
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
    locale: str = Depends(get_locale),
    request_id: str = Depends(get_request_id)
) -> ApiResponse[List[DeviceResponse]]:
    """获取设备列表"""
    
    devices, total = await device_crud.get_multi(db, skip, limit, device_type)
    
    # ⭐ 使用分页响应
    return paginated_response(
        items=[DeviceResponse.model_validate(d) for d in devices],
        skip=skip,
        limit=limit,
        total=total,
        message=t("device.success.list", locale),
        locale=locale,
        request_id=request_id
    )

# ⭐ 更新设备
@router.patch(
    "/{device_id}",
    response_model=ApiResponse[DeviceResponse],
    summary="更新设备",
    description="更新设备信息"
)
@audit_route(
    module="device",
    action="update_device",
    action_key="audit.action.device_updated"
)
async def update_device(
    device_id: int,
    device_in: DeviceUpdate,
    request: Request,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
    locale: str = Depends(get_locale),
    request_id: str = Depends(get_request_id)
) -> ApiResponse[DeviceResponse]:
    """更新设备"""
    
    # 获取设备
    device = await device_crud.get_by_id(db, device_id)
    if not device:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=t("device.error.not_found", locale)
        )
    
    # ⭐ 记录变更（before）
    device_before = DeviceResponse.model_validate(device)
    
    # 更新设备
    device = await device_crud.update(db, device, device_in)
    
    # ⭐ 设置审计目标和变更
    set_audit_target(request, "device", str(device.id), device.name)
    set_audit_changes(
        request,
        device_before.model_dump(),
        DeviceResponse.model_validate(device).model_dump()
    )
    
    return success_response(
        data=DeviceResponse.model_validate(device),
        message=t("device.success.updated", locale),
        locale=locale,
        request_id=request_id
    )

# ⭐ 删除设备
@router.delete(
    "/{device_id}",
    response_model=ApiResponse[None],
    summary="删除设备",
    description="删除设备"
)
@audit_route(
    module="device",
    action="delete_device",
    action_key="audit.action.device_deleted"
)
async def delete_device(
    device_id: int,
    request: Request,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
    locale: str = Depends(get_locale),
    request_id: str = Depends(get_request_id)
) -> ApiResponse[None]:
    """删除设备"""
    
    # 获取设备
    device = await device_crud.get_by_id(db, device_id)
    if not device:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=t("device.error.not_found", locale)
        )
    
    # ⭐ 设置审计目标
    set_audit_target(request, "device", str(device.id), device.name)
    
    # 删除设备
    await device_crud.delete(db, device)
    
    return success_response(
        data=None,
        message=t("device.success.deleted", locale),
        locale=locale,
        request_id=request_id
    )
```

