## 💡 常见错误

### ❌ 错误示例 1: 引入新库

```typescript
// ❌ 错误
import moment from 'moment'  // 项目没有使用 moment

// ✅ 正确
// 使用原生 Date 或 date-fns（如果项目已有）
```

### ❌ 错误示例 2: 不使用现有机制

```typescript
// ❌ 错误
const [user, setUser] = useState()  // 认证状态应该用 Zustand

// ✅ 正确
import { useAuth } from '@/hooks/useAuth'
const { user } = useAuth()
```

### ❌ 错误示例 3: 硬编码文本

```typescript
// ❌ 错误
<Button>保存</Button>

// ✅ 正确
const { t } = useTranslation('common')
<Button>{t('common.save')}</Button>
```

### ❌ 错误示例 4: 不使用类型

```typescript
// ❌ 错误
function getUser(id: any): any { }

// ✅ 正确
import type { User } from '@/types'
function getUser(id: number): Promise<User> { }
```

### ❌ 错误示例 5: 文件下载不处理二进制数据

```typescript
// ❌ 错误：直接用 <a> 标签（无法携带 token）
export const downloadFile = (fileId: number) => {
  const url = `${API_URL}/files/${fileId}/download`
  window.open(url)  // 无法携带认证信息！
}

// ❌ 错误：不指定 responseType（文件会损坏）
export const downloadFile = async (fileId: number) => {
  const response = await http.get(`/files/${fileId}/download`)
  // response.data 会被当作 JSON 解析，导致文件损坏
}

// ✅ 正确：使用 axios + blob
export const downloadFile = async (fileId: number, filename: string) => {
  const response = await http.get(
    `/files/${fileId}/download`,
    { responseType: 'blob' }  // ⭐ 必须指定
  )
  
  const blob = response.data as unknown as Blob
  const url = window.URL.createObjectURL(blob)
  const link = document.createElement('a')
  link.href = url
  link.download = filename
  document.body.appendChild(link)
  link.click()
  document.body.removeChild(link)
  window.URL.revokeObjectURL(url)
}
```

### ❌ 错误示例 6: 固定宽度导致文字截断

```typescript
// ❌ 错误：固定宽度（英文会截断）
<SelectTrigger className="w-[100px]">
  <SelectValue />  {/* "Any Direction" → "Any Direc" */}
</SelectTrigger>

// ✅ 正确：自适应宽度
<SelectTrigger className="flex-1 min-w-[130px]">
  <SelectValue />  {/* 完整显示 */}
</SelectTrigger>
```

### ❌ 错误示例 7: 长时间 API 使用默认超时

```typescript
// ❌ 错误：使用默认 30 秒超时（API 可能需要 5 分钟）
export const traceroute = async (params: { maxHops: 64, timeout: 5 }) => {
  return await http.post('/traceroute', params)
  // 前端 30 秒后超时，但后端还在运行！
}

// ✅ 正确：动态计算超时
export const traceroute = async (params: { maxHops: number, timeout: number }) => {
  const timeoutMs = (params.timeout * params.maxHops + 60) * 1000
  return await http.post(
    '/traceroute',
    params,
    { timeout: timeoutMs }  // 前端不会先超时
  )
}
```

### ❌ 错误示例 8: 不清空旧状态

```typescript
// ❌ 错误：不清空旧结果
const onSubmit = (data) => {
  mutation.mutate(data)  // 旧结果还在页面上显示
}

// ✅ 正确：提交前清空
const onSubmit = (data) => {
  setResult(null)  // ⭐ 先清空
  mutation.mutate(data)
}
```

