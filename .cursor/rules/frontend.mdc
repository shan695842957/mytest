### 场景 9: 文件下载处理

**必须参考：**
1. `src/api/capture.ts` - 文件下载实现
2. `src/utils/request.ts` - HTTP 客户端

**标准步骤：**
```typescript
// 1. 在 API 层添加下载函数
export const downloadFile = async (fileId: number, filename: string) => {
  try {
    // ⭐ 关键：使用 responseType: 'blob' 获取二进制数据
    const response = await http.get(
      `/files/${fileId}/download`,
      {
        responseType: 'blob',  // 必须指定！
      }
    )
    
    // 创建 Blob 对象
    const blob = response.data as unknown as Blob
    const url = window.URL.createObjectURL(blob)
    
    // 触发下载
    const link = document.createElement('a')
    link.href = url
    link.download = filename
    document.body.appendChild(link)
    link.click()
    
    // 清理资源
    document.body.removeChild(link)
    window.URL.revokeObjectURL(url)
  } catch (error) {
    console.error('下载失败:', error)
    throw error
  }
}

// 2. 在组件中使用（异步调用）
<Button
  onClick={async () => {
    try {
      await downloadFile(fileId, 'example.pcap')
      toast.success('下载成功')
    } catch (error) {
      toast.error('下载失败')
    }
  }}
>
  下载
</Button>
```

**❌ 不要：**
- 不要直接使用 `<a href>` 标签下载（无法携带认证 token）
- 不要忘记设置 `responseType: 'blob'`
- 不要忘记清理 `URL.revokeObjectURL()`

